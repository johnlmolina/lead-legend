# Copy to .env.local and fill in from your Supabase project (Project Settings → API
# and Project Settings → Database).

# Client-exposed (safe for the browser bundle)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only — NEVER prefix with NEXT_PUBLIC_, never reference from client code.
# Bypasses Row-Level Security entirely. See src/lib/supabase/service.ts.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only — Postgres connection string, used only by scripts/run-migrations.ts.
# Project Settings → Database → Connection string. Try "Direct connection" first;
# if it fails to resolve (some networks can't reach its IPv6-only address), use
# the "Session pooler" or "Transaction pooler" string instead — both work fine
# here since migrations run as a single plain-SQL transaction per file.
DATABASE_URL=

# Server-only. Get a key at https://console.anthropic.com/settings/keys — see
# ARCHITECTURE.md §5 for how it's used (structured output + a deterministic
# guardrail filter, not just a system prompt).
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-5

# Server-only. Get these from your Twilio Console (twilio.com) — Account SID
# and Auth Token are on the dashboard, the phone number is under Phone Numbers.
# Use E.164 format (+15551234567, no spaces/parens/dashes).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# The public URL Twilio can reach for webhooks (e.g. an ngrok tunnel in local
# dev, like https://abcd1234.ngrok-free.app). Needed for inbound SMS/calls and
# for the missed-call <Dial> status callback; outbound sending works without
# it. Also set this org's "Your Twilio number" to TWILIO_PHONE_NUMBER in
# Settings — that's the DB-side value the app actually looks up by.
PUBLIC_APP_URL=

# Server-only. From a Google Cloud OAuth client (Calendar API enabled) — see
# README.md for the full setup walkthrough. The redirect URI you register in
# Google Cloud must exactly match {PUBLIC_APP_URL or http://localhost:3000}
# + /api/integrations/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Server-only — a random 32-byte key (base64), used to encrypt the Google
# Calendar refresh token at rest. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing this after a calendar is connected makes the stored token
# undecryptable — the org would need to reconnect.
TOKEN_ENCRYPTION_KEY=

# --- Added in later phases (not needed yet) ---
# STRIPE_SECRET_KEY=
